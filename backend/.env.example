# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local example:      mongodb://127.0.0.1:27017/ewaste
# Atlas example:       mongodb+srv://<user>:<pass>@<cluster>/ewaste
MONGODB_URI=mongodb://127.0.0.1:27017/ewaste

# Will be used starting Phase 1 (Authentication)
JWT_SECRET=replace_with_a_long_random_string

# Phase 5 - ML price prediction microservice URL
ML_SERVICE_URL=http://localhost:8001

# Phase 6 - CV microservice URL
CV_SERVICE_URL=http://localhost:8002

# Phase 17 - production CORS lockdown (comma-separated origins). Defaults
# to permissive (*) if unset - fine for local dev, set explicitly in prod.
# CORS_ORIGIN=https://your-frontend-domain.com

# Phase 11 - GenAI chatbot. Leave unset to run without the chatbot -
# the rest of the app works fully without it. Get a key from
# https://console.anthropic.com if you want to enable it.
# GENAI_API_KEY=
# GENAI_MODEL=claude-3-5-haiku-20241022
