# Root-level example. Individual services also have their own .env.example:
#   backend/.env.example
#   frontend/.env.example
#
# This root file is mainly useful once docker-compose.yml orchestrates
# everything together (see Phase 17 - Deployment).

MONGODB_URI=mongodb://127.0.0.1:27017/ewaste
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Phase 17 - production deployment settings
# CORS_ORIGIN=https://your-frontend-domain.com
# VITE_API_BASE_URL=https://your-backend-domain.com
